{
  "name": "@everock/sdk",
  "version": "0.1.0-beta.2",
  "description": "SDK \u2014 captures errors and telemetry (browser + server) and ships them to an Everock surface.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./edge": "./src/edge.ts",
    "./build": "./src/build.ts",
    "./opentelemetry": "./src/opentelemetry.ts",
    "./fastify": "./src/fastify.ts",
    "./express": "./src/express.ts",
    "./frameworks": "./src/frameworks.ts",
    "./frameworks/edge": "./src/frameworks-edge.ts",
    "./nitro": "./src/nitro.ts"
  },
  "bin": {
    "sdk": "./bin/release.mjs",
    "everock-release": "./bin/release.mjs",
    "everock-sourcemaps": "./bin/sourcemaps.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@everock/shared": "workspace:*",
    "rrweb": "^2.1.0",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0"
  },
  "license": "Apache-2.0",
  "private": true
}
